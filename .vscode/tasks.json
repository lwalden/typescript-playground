{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current file (tsx)",
      "type": "shell",
      "command": "npx tsx ${file}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Open browser output (Vite)",
      "type": "shell",
      "command": "npx vite browser",
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready"
        }
      }
    },
    {
      "label": "New playground file",
      "type": "shell",
      "command": "node scripts/new.mjs ${input:filename}",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Type check",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$tsc"
    }
  ],
  "inputs": [
    {
      "id": "filename",
      "type": "promptString",
      "description": "Name for the new file (no extension, e.g. 'binary-search')",
      "default": "scratch"
    }
  ]
}
